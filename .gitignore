# Vendor artifacts and decompiler output never go into git
targets/*/artifacts/
targets/*/work/
targets/*/decompiled/
*.apk
*.xapk
*.apks
*.aab
*.ipa
*.dex
*.jar
*.so
*.bin.orig
.venv/
node_modules/
__pycache__/
.pytest_cache/
*.egg-info/
reports/*
!reports/README.md
targets/*/BUILD-INFO.txt
testmedia/
dumps/
# resources/: only exactly pinned vendor archives approved by the owner (REPO_COPY in targets/*/SOURCES.md, Git LFS).
# The *.xapk rule above still applies to loose files; decompiled output stays ignored.
resources/**
!resources/*/
!resources/README.md
!resources/c900/hiwear-plus-2.0.1.xapk.zip

# Owner Bluetooth captures (btsnoop, bug reports): private, never committed
captures/
targets/*/captures/
*.btsnoop
!tests/fixtures/*.btsnoop
btsnoop_hci.log*
bugreport*.zip
